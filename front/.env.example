# URL do microsserviço de pedidos.
# Em desenvolvimento, aponte para o servidor local (back/gestao_de_pedidos):
VITE_PEDIDOS_ENTREGA_SERVICE_URL=http://localhost:3005
# Em produção (Vercel) NÃO defina esta variável: o front usa automaticamente
# a função serverless em /api/gestao_de_pedidos.

# URL do microsserviço de notificações.
# Em desenvolvimento, aponte para o servidor local (back/notificacoes):
VITE_NOTIFICACOES_SERVICE_URL=http://localhost:3006
# Em produção (Vercel) NÃO defina esta variável: o front usa automaticamente
# a função serverless em /api/notificacoes.
